APP_NAME="SmartLab"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info

RUN_MIGRATIONS=true
RUN_SEEDER=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=smartlab
DB_USERNAME=smartlab
DB_PASSWORD=smartlab-local-password
DB_SSLMODE=prefer

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

SIMULATION_API_URL=http://simulation:8000
SIMULATION_TIMEOUT=20
SMART_LAB_API_KEY=change-this-shared-service-secret

# Optional. Without these values, the safe built-in SmartLab tutor remains available.
# Hugging Face Inference Providers
# Without HF_TOKEN, SmartLab uses its built-in offline assistant.
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen2.5-7B-Instruct-1M
HF_TIMEOUT=45
HF_MAX_TOKENS=700

ADMIN_EMAIL=admin@smartlab.test
ADMIN_PASSWORD=SmartLab2026!
FRONTEND_URLS=http://localhost:5173,http://localhost:8080
