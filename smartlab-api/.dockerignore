# Version control
.git
.gitattributes
.gitignore

# Dependencies (installed fresh in the image)
/vendor
/node_modules

# Environment / secrets
.env
.env.*
!.env.example

# Local dev tooling
.editorconfig
.styleci.yml
.php-cs-fixer.cache
.phpunit.result.cache
phpunit.xml
.idea
.vscode
*.iml

# Tests (not needed at runtime)
/tests

# Docker files themselves
Dockerfile
docker-compose.yml
docker-compose.*.yml
.dockerignore

# OS / editor cruft
.DS_Store
Thumbs.db

# Logs and generated cache CONTENTS only — keep the directories themselves
# so Laravel has somewhere to write on first boot.
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
!storage/logs/.gitignore
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore

# Compiled frontend assets rebuilt during image build (adjust if you ship prebuilt assets)
/public/hot